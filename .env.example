# Copy to .env.local (web/) or export in your shell for local dev. Never commit real values.
# Where each value lives in staging and prod: docs/environments.md
# Variables for services that aren't wired up yet are listed so the names stay consistent.

# --- Supabase (web app, workers) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS, so never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Modal (workers) ---
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# --- Anthropic API (assistant) ---
ANTHROPIC_API_KEY=

# --- Stripe (billing) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
