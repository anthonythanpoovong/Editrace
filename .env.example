# Copy to .env.local (web/) or export in your shell for local dev. Never commit real values.
# Where each value lives in staging and prod: docs/environments.md
# Variables for services that aren't wired up yet are listed so the names stay consistent.

# --- App ---
# dev | preview | staging | prod. Stamped on every log line and Sentry event (docs/observability.md).
APP_ENV=dev

# --- Supabase (web app, workers) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS, so never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Supabase migrations (deploy.yml only) ---
# GitHub environment secrets/variables (staging and Production), not for .env.local.
# Never put real values here or in web/.env.local. See docs/environments.md.
SUPABASE_PROJECT_REF=
SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_PASSWORD=

# --- Modal (workers) ---
# Local `modal` CLI use only: run `modal token new` to fill these in. Staging and prod tokens are GitHub environment secrets,
# one service user per Modal environment (docs/environments.md#modal). Never use a prod token locally.
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
# Deploy to `staging` by hand, never `prod` or `main`.
MODAL_ENVIRONMENT=staging

# --- Anthropic API (assistant) ---
ANTHROPIC_API_KEY=

# --- Sentry (error tracking, docs/observability.md) ---
# DSNs are not secret (they only allow sending events), but keep them out of git anyway.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# CI only: uploads source maps on deploy. This one is secret.
SENTRY_AUTH_TOKEN=

# --- Stripe (billing) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
